<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donar_titulo"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/donar_mensaje"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/donar_elige_monto"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/donar_20"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/donar_monto_20" />

        <Button
            android:id="@+id/donar_50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donar_monto_50" />

        <Button
            android:id="@+id/donar_100"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donar_monto_100" />

        <Button
            android:id="@+id/donar_otro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/donar_otro_monto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/donar_gracias"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
